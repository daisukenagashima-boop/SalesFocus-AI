# Notion 連携（任意。未設定でもアプリは動作し、同期だけ無効になります）
# https://www.notion.so/my-integrations でインテグレーションを作成し、
# 「DB05_案件（CRM）」と「DB06_活動（CRM）」のあるページに Connections で接続してください。
NOTION_API_KEY=

# 案件CRM / 活動CRM のデータベースID（既定値はこのワークスペースの値）
NOTION_DEALS_DB_ID=b2eaa45a-3f13-83bc-bb6e-812739cff3a5
NOTION_ACTIVITIES_DB_ID=c80aa45a-3f13-839c-b0be-019a9989992e

# バックエンドAPIのポート
API_PORT=8787

# APIのbind先。既定は自PC内のみ(127.0.0.1)。社内LANの他端末から使う場合のみ 0.0.0.0
API_HOST=127.0.0.1

# Excel取込を許可するベースディレクトリ（任意ファイル読取防止。既定はホーム配下）
# EXCEL_BASE_DIR=/Users/nagashimadaisuke

# 目標Excelの既定パス（目標管理ページからの「再インポート」で使用）
TARGET_EXCEL_PATH=/Users/nagashimadaisuke/Downloads/営業計画_目標_統合版 (1).xlsx

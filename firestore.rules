rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // For this corporate app, we'll allow all signed-in users within the same org to read everything.
    // In a real production app, we'd add role-based access.

    match /members/{memberId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /targets/{targetId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /salesRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /aiInsights/{insightId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /performanceMetrics/{metricId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
